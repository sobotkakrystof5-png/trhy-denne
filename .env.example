# Vzor proměnných prostředí. Jen názvy, hodnoty nikdy do Gitu (zadání 5.9).
# Lokálně zkopírujte do .env.local. Na Vercelu se nastavují v projektu.
# Bez databáze, tajemství a e-mailu vrací odběr a přihlášení pravdivě 503.

# Neon. Lokálně: postgres://postgres:postgres@localhost:54329/main
# (docker compose up -d, viz docker-compose.yml)
DATABASE_URL=
# Omezený databázový uživatel pro n8n (fáze 5).
DATABASE_URL_N8N=

# Better Auth. Aspoň 32 náhodných znaků: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend. Bez klíče se ve vývoji odkazy z e-mailů jen vypíšou do konzole.
RESEND_API_KEY=
# Třeba "Trhy denně <prehled@domena.cz>". Doména musí být ověřená v Resendu.
EMAIL_FROM=

# Stripe (fáze 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PLUS=

# n8n (fáze 5)
INTERNAL_HMAC_SECRET=
N8N_EVENT_WEBHOOK_URL=

# PostHog (fáze 5, po souhlasu)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Veřejná adresa webu, z ní se skládají odkazy v e-mailech. Lokálně http://localhost:3000
NEXT_PUBLIC_SITE_URL=
